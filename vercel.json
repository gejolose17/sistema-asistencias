{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?__vercel_route=/api/$1" },
    { "source": "/asistencia/(.*)", "destination": "/asistencia.html" },
    { "source": "/a/(.*)", "destination": "/asistencia.html" },
    { "source": "/acta/(.*)", "destination": "/acta.html" }
  ]
}
